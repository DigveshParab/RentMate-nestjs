generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VehicleType {
  id       Int       @id @default(autoincrement())
  type     String
  wheels   Int
  vehicles Vehicle[]
}

model Vehicle {
  id            Int         @id @default(autoincrement())
  name          String
  vehicleTypeId Int
  Booking       Booking[]
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
}

model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  vehicleId Int
  Vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}
